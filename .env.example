# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
DB_PATH=/mnt/media/projects/price_history/data/prices.db
LOG_DIR=/mnt/media/projects/price_history/logs
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serve a built frontend from this directory (default in production: frontend/dist/frontend)
FRONTEND_DIST=
SCRAPE_INTERVAL_MINUTES=360
SCRAPE_JITTER_SECONDS=120
SAVE_SNAPSHOTS=false

# Scheduler
SCHEDULER_ENABLED=true
SCRAPE_SITE_DELAY_SECONDS=20
SCRAPE_MAX_RETRIES=2
SCRAPE_RETRY_BASE_MS=2000
SCRAPE_MAX_CONSECUTIVE_FAILURES=5

# Alerts - Telegram (chosen channel). Create a bot with @BotFather, then paste its token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alerts - email (optional, needs SMTP_HOST + ALERT_EMAIL_FROM + ALERT_EMAIL_TO to enable)
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Alerts - desktop via node-notifier (optional, opt-in; only works where a GUI session exists)
ALERT_DESKTOP_ENABLED=false

# Amazon Product Advertising API (leave blank until an Associates account exists)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Flipkart Affiliate API (leave blank until an Affiliate account exists)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
